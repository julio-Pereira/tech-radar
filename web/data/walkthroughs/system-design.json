              "n": 6,
              "de": "spi",
              "para": "arquivo",
              "msg": "O fake do SPI recebe a ordem atrasada, liquida e registra no arquivo do dia",
              "anotacao": "o pix-gateway ainda não sabe",
              "estados": {
                "gw": "destaque",
                "ledger": "novo",
                "spi": "ativo"
              }
            }
          ],
          "sequencia": {
            "id": "sd-pix-resultado-desconhecido-spi",
            "tipo": "sequencia",
            "titulo": "Enquanto isso, no SPI",
            "descricao": "Etapa \"Enquanto isso, no SPI\" em sequência: 1 eventos entre 2 atores.",
