          "titulo": "a falha injetada (Toxiproxy)",
          "nota": "Portas e nomes do laboratório, ilustrativos",
          "linhas": [
            "# o pix-gateway aponta para a porta do proxy, nunca para o fake do SPI",
            "toxiproxy-cli create -l localhost:26090 -u localhost:8090 fake-spi",
            "# 8 s de latência, acima do timeout configurado no pix-gateway",
            "toxiproxy-cli toxic add -t latency -a latency=8000 fake-spi"
