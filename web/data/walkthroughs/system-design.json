      "etapas": [
        {
          "id": "pedido",
          "titulo": "O pedido e a reserva",
          "subtitulo": "Síncrono e local",
          "camada": "teste",
          "html": "\u003cp\u003eAté aqui, nada de novo em relação ao fluxo feliz: validação de limite e antifraude,\nsíncronas, e a \u003cstrong\u003ereserva\u003c/strong\u003e no ledger, que debita e marca como \u0026#34;em trânsito\u0026#34; numa transação\nlocal. A chave de idempotência vem do pedido e vai até o SPI.\u003c/p\u003e\n",
          "eventos": [
