        {
          "id": "silencio",
          "titulo": "O envio cai no silêncio",
          "subtitulo": "Resultado desconhecido não é falha",
          "camada": "teste",
          "html": "\u003cp\u003eA partir do envio, o fluxo sai do controle do sistema. No teste, o Toxiproxy segura a\nordem por 8 segundos, mais que o timeout configurado. O pix-gateway não sabe se o SPI\nliquidou. Dizer \u0026#34;falhou\u0026#34; ou \u0026#34;concluído\u0026#34; ao cliente seria mentir, e reenviar arriscaria\num segundo pagamento.\u003c/p\u003e\n",
          "eventos": [
            {
              "n": 3,
              "de": "gw",
              "para": "toxi",
              "msg": "O pix-gateway envia a ordem ao SPI, que no teste passa pelo Toxiproxy",
              "estados": {
                "ledger": "novo"
              },
              "painel": {
                "id": "toxi",
                "de": 1,
                "ate": 2
              }
            },
            {
              "n": 4,
              "de": "toxi",
              "para": "spi",
              "msg": "O Toxiproxy segura a ordem por 8 s antes de entregá-la ao fake do SPI",
              "anotacao": "acima do timeout configurado",
              "estados": {
                "ledger": "novo"
              },
              "painel": {
                "id": "toxi",
                "de": 3,
                "ate": 4
              }
            },
            {
              "n": 5,
              "de": "gw",
              "para": "cliente",
              "msg": "Estoura o timeout, e o pix-gateway responde ao cliente: pagamento em processamento",
              "anotacao": "nunca falhou, nunca concluído",
              "estados": {
                "gw": "destaque",
                "ledger": "novo"
              },
              "painel": {
                "id": "ledger",
                "de": 2,
                "ate": 2
              }
            }
          ],
          "sequencia": {
            "id": "sd-pix-resultado-desconhecido-silencio",
            "tipo": "sequencia",
            "titulo": "O envio cai no silêncio",
