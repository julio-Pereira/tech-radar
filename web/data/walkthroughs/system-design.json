          "titulo": "lançamentos e estados no ledger",
          "nota": "Ilustrativo: um pagamento, do débito ao destino",
          "linhas": [
            "p-0042  idem k-9b1e  RESERVA  -120.00  EM_TRANSITO",
            "p-0042  idem k-9b1e  ESTADO            ENVIADO_AO_SPI",
            "p-0042  idem k-9b1e  ESTADO            EM_VERIFICACAO  prazo: conciliação D+1",
            "p-0042  idem k-9b1e  EFETIVA  -120.00  LIQUIDADO       origem: conciliação D+1"
          ]
        }
