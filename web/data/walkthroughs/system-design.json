                "spi": "ativo",
                "toxi": "falha"
              }
            },
            {
              "n": 12,
              "de": "conc",
              "para": "ledger",
              "msg": "A conciliação resolve no ledger: o débito em trânsito vira definitivo, LIQUIDADO",
