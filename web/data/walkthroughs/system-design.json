            },
            {
              "n": 8,
              "de": "toxi",
              "para": "gw",
              "msg": "A consulta cai na mesma latência e não volta no prazo",
              "estados": {
                "gw": "destaque",
                "ledger": "novo",
                "spi": "ativo",
                "toxi": "falha"
              }
            },
            {
              "n": 9,
              "de": "gw",
              "para": "ledger",
              "msg": "O pagamento entra em EM_VERIFICACAO, com prazo declarado e alerta",
              "estados": {
                "gw": "destaque",
                "ledger": "destaque",
                "spi": "ativo",
                "toxi": "falha"
              },
              "painel": {
