        {
          "id": "iniciacao",
          "titulo": "A iniciação chega à detentora",
          "subtitulo": "Conferir, consumir, avaliar",
          "camada": "detentora",
          "html": "\u003cp\u003eA ação desce para dentro da detentora. Valor e recebedor da iniciação precisam ser\n\u003cstrong\u003eidênticos\u003c/strong\u003e aos do consentimento: uma diferença é outra operação, e é recusada. Conferido,\no consentimento é consumido. Limites e antifraude olham o perfil de risco próprio da\niniciação por terceiros.\u003c/p\u003e\n",
          "eventos": [
            {
              "n": 5,
              "de": "itp",
              "para": "pag",
              "msg": "A ITP inicia o pagamento com a sua chave de idempotência"
            },
            {
              "n": 6,
              "de": "pag",
              "para": "cons",
              "msg": "A API de pagamentos confere valor e recebedor contra o consentimento: idênticos",
              "anotacao": "qualquer diferença é recusada"
            },
            {
              "n": 7,
              "de": "cons",
              "para": "pag",
              "msg": "O consentimento é consumido e não autoriza mais nenhum movimento",
              "anotacao": "uso único, mesmo que algo falhe depois",
              "estados": {
                "cons": "removido"
              }
            },
            {
              "n": 8,
              "de": "pag",
              "para": "antifraude",
              "msg": "A API de pagamentos passa a iniciação por limites e antifraude",
              "estados": {
                "cons": "removido"
              }
            },
            {
              "n": 9,
              "de": "antifraude",
              "para": "pag",
              "msg": "Limites e antifraude aprovam",
              "estados": {
                "cons": "removido"
              }
            }
          ],
