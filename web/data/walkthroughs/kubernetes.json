          "rotulo": "kube-scheduler"
        },
        {
          "id": "kubelet",
          "rotulo": "kubelet (worker2)"
        },
        {
          "id": "cri",
          "rotulo": "containerd"
        },
        {
          "id": "cni",
          "rotulo": "plugin CNI"
        },
        {
