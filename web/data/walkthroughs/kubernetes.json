  "walkthroughs": {
    "k8s-do-apply-ao-pod-ready": {
      "id": "k8s-do-apply-ao-pod-ready",
      "titulo": "Do kubectl apply ao Pod recebendo tráfego",
      "resumo": "Ninguém manda o nó rodar o Pod: cada componente observa o API server e reage ao que mudou.",
      "atores": [
        {
          "id": "kubectl",
          "rotulo": "kubectl"
        },
        {
          "id": "api",
          "rotulo": "kube-apiserver"
