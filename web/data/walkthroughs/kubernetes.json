      "paineis": [
        {
          "id": "deployment",
          "linguagem": "yaml",
          "titulo": "deployment.yaml",
          "linhas": [
            "apiVersion: apps/v1",
            "kind: Deployment",
            "metadata:",
            "  name: pix-gateway",
            "  namespace: payments",
            "spec:",
            "  replicas: 3",
            "  selector:",
            "    matchLabels: { app.kubernetes.io/name: pix-gateway }",
            "  template:",
            "    metadata:",
            "      labels: { app.kubernetes.io/name: pix-gateway }",
            "    spec:",
            "      containers:",
            "        - name: pix-gateway",
            "          image: ghcr.io/fin/pix-gateway@sha256:9c8f2e…",
            "          resources:",
            "            requests: { cpu: 250m, memory: 512Mi }",
            "          readinessProbe:",
            "            httpGet: { path: /actuator/health/readiness, port: 8080 }",
            "            periodSeconds: 5"
          ]
        },
        {
          "id": "eventos",
          "linguagem": "log",
          "titulo": "kubectl get events -n payments --watch",
          "nota": "Saída ilustrativa, sem as colunas LAST SEEN e TYPE",
          "linhas": [
            "REASON             OBJECT                          MESSAGE",
            "ScalingReplicaSet  deployment/pix-gateway          Scaled up replica set pix-gateway-7c9d6f from 0 to 3",
            "SuccessfulCreate   replicaset/pix-gateway-7c9d6f   Created pod: pix-gateway-7c9d6f-x2k8p",
            "Scheduled          pod/pix-gateway-7c9d6f-x2k8p    Successfully assigned payments/pix-gateway-7c9d6f-x2k8p to fin-platform-worker2",
            "Pulling            pod/pix-gateway-7c9d6f-x2k8p    Pulling image \"ghcr.io/fin/pix-gateway@sha256:9c8f2e…\"",
            "Pulled             pod/pix-gateway-7c9d6f-x2k8p    Successfully pulled image \"ghcr.io/fin/pix-gateway@sha256:9c8f2e…\" in 2.8s (2.8s including waiting). Image size: 98304512 bytes.",
            "Created            pod/pix-gateway-7c9d6f-x2k8p    Container created",
            "Started            pod/pix-gateway-7c9d6f-x2k8p    Container started"
          ]
        }
      ],
      "etapas": [
        {
          "id": "pedido",
          "titulo": "O pedido chega",
          "subtitulo": "Gravar não é executar",
          "camada": "cluster",
          "html": "\u003cp\u003eO \u003ccode\u003ekubectl apply\u003c/code\u003e não executa nada. Ele entrega uma \u003cstrong\u003edeclaração\u003c/strong\u003e ao API server, a\núnica porta de entrada do cluster, que autentica, autoriza, passa pela admissão e\ngrava no etcd. A resposta volta antes de existir qualquer Pod: é por isso que o\napply \u0026#34;deu certo\u0026#34; e nada mudou ainda.\u003c/p\u003e\n",
          "eventos": [
            {
              "n": 1,
              "de": "kubectl",
              "para": "api",
              "msg": "O kubectl envia o Deployment por HTTPS, autenticado pelo certificado do kubeconfig",
              "painel": {
                "id": "deployment",
                "de": 1,
                "ate": 5
              }
            },
            {
              "n": 2,
              "de": "api",
              "para": "etcd",
              "msg": "Autorizado pelo RBAC e aprovado pela admissão, o Deployment é gravado no etcd"
            },
            {
              "n": 3,
              "de": "api",
              "para": "kubectl",
              "msg": "O API server responde 201 Created. O kubectl termina aqui, e nenhum Pod existe ainda",
              "anotacao": "o apply retorna antes de qualquer Pod existir"
            }
          ],
          "sequencia": {
            "id": "k8s-do-apply-ao-pod-ready-pedido",
            "tipo": "sequencia",
            "titulo": "O pedido chega",
            "descricao": "Etapa \"O pedido chega\" em sequência: 3 eventos entre 3 atores.",
            "participantes": [
              {
                "id": "kubectl",
                "rotulo": "kubectl"
              },
              {
                "id": "api",
                "rotulo": "kube-apiserver"
              },
              {
                "id": "etcd",
                "rotulo": "etcd"
              }
            ],
            "mensagens": [
              {
                "de": "kubectl",
                "para": "api",
                "rotulo": "apply",
                "tipo": "sync"
              },
              {
                "de": "api",
                "para": "etcd",
                "rotulo": "grava",
                "tipo": "sync"
              },
              {
                "de": "api",
                "para": "kubectl",
                "rotulo": "201 Created",
                "tipo": "reply"
              }
            ]
          },
          "omitidos": 7
        },
        {
          "id": "controllers",
          "titulo": "Os controllers reagem",
          "subtitulo": "Cada um reconcilia o próximo",
          "camada": "cluster",
          "html": "\u003cp\u003eNinguém chama o controller-manager. Os controllers mantêm um \u003cstrong\u003ewatch\u003c/strong\u003e no API server\ne acordam quando um objeto do seu tipo muda. O Deployment controller cria um\nReplicaSet; o ReplicaSet controller vê que faltam Pods e cria os registros. Cada passo\né uma escrita no API server, que dispara o próximo watch.\u003c/p\u003e\n",
          "eventos": [
            {
              "n": 4,
              "de": "api",
              "para": "kcm",
              "msg": "O Deployment controller, que mantém um watch, é notificado do Deployment novo"
            },
            {
              "n": 5,
              "de": "kcm",
              "para": "api",
              "msg": "Ele cria um ReplicaSet com o template do Pod e replicas: 3",
              "painel": {
                "id": "eventos",
                "de": 2,
                "ate": 2
              }
            },
            {
              "n": 6,
              "de": "api",
              "para": "kcm",
              "msg": "O ReplicaSet controller vê um ReplicaSet com 0 de 3 Pods",
              "painel": {
                "id": "deployment",
                "de": 7,
                "ate": 7
              }
            },
            {
              "n": 7,
              "de": "kcm",
              "para": "api",
              "msg": "Ele cria 3 Pods. São só registros: spec.nodeName vazio, nada rodando",
              "painel": {
                "id": "eventos",
                "de": 3,
                "ate": 3
              }
            }
          ],
          "sequencia": {
            "id": "k8s-do-apply-ao-pod-ready-controllers",
            "tipo": "sequencia",
            "titulo": "Os controllers reagem",
            "descricao": "Etapa \"Os controllers reagem\" em sequência: 4 eventos entre 2 atores.",
            "participantes": [
              {
                "id": "api",
                "rotulo": "kube-apiserver"
              },
              {
                "id": "kcm",
                "rotulo": "kube-controller-manager"
              }
            ],
            "mensagens": [
              {
                "de": "api",
                "para": "kcm",
                "rotulo": "watch",
                "tipo": "async"
              },
              {
                "de": "kcm",
                "para": "api",
                "rotulo": "cria objetos",
                "tipo": "sync"
              },
              {
                "de": "api",
                "para": "kcm",
                "rotulo": "watch",
                "tipo": "async"
              },
              {
                "de": "kcm",
                "para": "api",
                "rotulo": "cria objetos",
                "tipo": "sync"
              }
            ]
          },
          "omitidos": 8
        },
        {
          "id": "scheduling",
          "titulo": "O scheduler escolhe o nó",
          "subtitulo": "Decidir não é executar",
          "camada": "cluster",
          "html": "\u003cp\u003eO scheduler observa Pods sem \u003ccode\u003enodeName\u003c/code\u003e. Para cada um, descarta os nós em que ele não\ncabe pelos \u003ccode\u003erequests\u003c/code\u003e (marco 05), pontua os que sobram e grava a decisão como um\n\u003cstrong\u003eBinding\u003c/strong\u003e. Ele nunca fala com o nó escolhido: a decisão vira um campo no API server.\u003c/p\u003e\n",
          "eventos": [
            {
              "n": 8,
              "de": "api",
              "para": "sched",
              "msg": "O scheduler observa Pods sem nó, e este entra na fila"
            },
            {
              "n": 9,
              "de": "sched",
              "para": "api",
              "msg": "Filtra e pontua os nós pelos requests e grava um Binding para o worker2",
              "anotacao": "o scheduler nunca contata o nó",
              "painel": {
                "id": "deployment",
                "de": 17,
                "ate": 18
              }
            }
          ],
          "sequencia": {
            "id": "k8s-do-apply-ao-pod-ready-scheduling",
            "tipo": "sequencia",
            "titulo": "O scheduler escolhe o nó",
            "descricao": "Etapa \"O scheduler escolhe o nó\" em sequência: 2 eventos entre 2 atores.",
            "participantes": [
              {
                "id": "api",
                "rotulo": "kube-apiserver"
              },
              {
                "id": "sched",
                "rotulo": "kube-scheduler"
              }
            ],
            "mensagens": [
              {
                "de": "api",
                "para": "sched",
                "rotulo": "watch",
                "tipo": "async"
              },
              {
                "de": "sched",
                "para": "api",
                "rotulo": "Binding",
                "tipo": "sync"
              }
            ]
          },
          "omitidos": 8
        },
        {
          "id": "kubelet",
          "titulo": "O kubelet assume",
          "subtitulo": "O nó puxa o trabalho",
          "camada": "worker2",
          "html": "\u003cp\u003eA ação desce para dentro do nó. O kubelet do worker2 só observa Pods com o seu nome em\n\u003ccode\u003enodeName\u003c/code\u003e. Ao ver um, prepara o terreno pelo containerd: um \u003cstrong\u003esandbox\u003c/strong\u003e com o\nnamespace de rede do Pod, ligado à rede pelo plugin CNI.\u003c/p\u003e\n",
          "eventos": [
            {
              "n": 10,
              "de": "api",
              "para": "kubelet",
              "msg": "O kubelet do worker2 só observa Pods do seu nó, e agora há um",
              "painel": {
                "id": "eventos",
                "de": 4,
                "ate": 4
              }
            },
            {
              "n": 11,
              "de": "kubelet",
              "para": "cri",
              "msg": "Pela CRI, o kubelet pede um sandbox: o namespace de rede e a casa vazia do Pod"
            },
            {
              "n": 12,
              "de": "cri",
              "para": "cni",
              "msg": "O containerd chama o plugin CNI, que liga o Pod à rede e atribui um IP"
            }
          ],
          "sequencia": {
            "id": "k8s-do-apply-ao-pod-ready-kubelet",
            "tipo": "sequencia",
            "titulo": "O kubelet assume",
            "descricao": "Etapa \"O kubelet assume\" em sequência: 3 eventos entre 4 atores.",
            "participantes": [
              {
                "id": "api",
                "rotulo": "kube-apiserver"
              },
              {
                "id": "kubelet",
                "rotulo": "kubelet (worker2)"
              },
              {
                "id": "cri",
                "rotulo": "containerd"
              },
              {
                "id": "cni",
                "rotulo": "plugin CNI"
              }
            ],
            "mensagens": [
              {
                "de": "api",
                "para": "kubelet",
                "rotulo": "watch do nó",
                "tipo": "async"
              },
              {
                "de": "kubelet",
                "para": "cri",
                "rotulo": "CRI",
                "tipo": "sync"
              },
              {
                "de": "cri",
                "para": "cni",
                "rotulo": "CNI ADD",
                "tipo": "sync"
              }
            ]
          },
          "omitidos": 6
        },
        {
          "id": "container",
          "titulo": "Imagem e container",
          "subtitulo": "A parte lenta",
          "camada": "worker2",
          "html": "\u003cp\u003eCom o sandbox pronto, o kubelet pede a imagem e o container. O pull costuma ser o passo\nmais demorado de todo o roteiro, e é por isso que a imagem fixada por digest e já em\ncache no nó encurta o tempo até o Pod existir.\u003c/p\u003e\n",
          "eventos": [
            {
              "n": 13,
              "de": "kubelet",
              "para": "cri",
              "msg": "O kubelet pede a imagem do pix-gateway. O pull costuma ser a parte lenta",
              "painel": {
                "id": "eventos",
                "de": 5,
                "ate": 6
              }
            },
            {
              "n": 14,
              "de": "cri",
              "para": "pod",
              "msg": "O containerd cria o container dentro do sandbox e o inicia",
              "anotacao": "os outros 2 Pods seguem o mesmo caminho, em paralelo",
              "estados": {
                "pod": "novo"
              },
              "painel": {
                "id": "eventos",
                "de": 7,
                "ate": 8
              }
            }
          ],
          "sequencia": {
            "id": "k8s-do-apply-ao-pod-ready-container",
            "tipo": "sequencia",
            "titulo": "Imagem e container",
            "descricao": "Etapa \"Imagem e container\" em sequência: 2 eventos entre 3 atores.",
            "participantes": [
              {
                "id": "kubelet",
                "rotulo": "kubelet (worker2)"
              },
              {
                "id": "cri",
                "rotulo": "containerd"
              },
              {
                "id": "pod",
                "rotulo": "pix-gateway-…-x2k8p"
              }
            ],
            "mensagens": [
              {
                "de": "kubelet",
                "para": "cri",
                "rotulo": "CRI",
                "tipo": "sync"
              },
              {
                "de": "cri",
                "para": "pod",
                "rotulo": "cria",
                "tipo": "sync"
              }
            ]
          },
          "omitidos": 7
        },
        {
          "id": "pronto",
          "titulo": "Rodando não é pronto",
          "subtitulo": "Running ≠ Ready",
          "camada": "worker2",
          "html": "\u003cp\u003eO container está rodando, mas ainda não recebe tráfego. O kubelet roda a\n\u003cstrong\u003ereadinessProbe\u003c/strong\u003e (marco 06) e só quando ela passa marca o Pod como Ready. A\naplicação decide quando está pronta, não o Kubernetes.\u003c/p\u003e\n",
          "eventos": [
            {
              "n": 15,
              "de": "kubelet",
              "para": "pod",
              "msg": "A readiness probe começa. Até ela passar, o Pod não recebe tráfego",
              "anotacao": "Running ≠ Ready",
              "estados": {
                "pod": "novo"
              },
              "painel": {
                "id": "deployment",
                "de": 19,
                "ate": 21
              }
            },
            {
              "n": 16,
              "de": "kubelet",
              "para": "api",
              "msg": "Probe ok: o kubelet atualiza o status do Pod para Ready no API server",
              "estados": {
                "pod": "ativo"
              }
            }
          ],
          "sequencia": {
            "id": "k8s-do-apply-ao-pod-ready-pronto",
            "tipo": "sequencia",
            "titulo": "Rodando não é pronto",
            "descricao": "Etapa \"Rodando não é pronto\" em sequência: 2 eventos entre 3 atores.",
            "participantes": [
              {
                "id": "api",
                "rotulo": "kube-apiserver"
              },
              {
                "id": "kubelet",
                "rotulo": "kubelet (worker2)"
              },
              {
                "id": "pod",
                "rotulo": "pix-gateway-…-x2k8p"
              }
            ],
            "mensagens": [
              {
                "de": "kubelet",
                "para": "pod",
                "rotulo": "probe",
                "tipo": "sync"
              },
              {
                "de": "kubelet",
                "para": "api",
                "rotulo": "status",
                "tipo": "sync"
              }
            ]
          },
          "omitidos": 7
        },
        {
          "id": "service",
          "titulo": "O Pod entra no Service",
          "subtitulo": "Tráfego, enfim",
          "camada": "cluster",
          "html": "\u003cp\u003eDe volta ao cluster. O controller de EndpointSlice, mais um laço do controller-manager,\nvê o Pod Ready e grava o IP dele no EndpointSlice do Service. Cada kube-proxy observa\nos EndpointSlices e reprograma as regras do seu nó (marco 04). Só aqui o Pod recebe a\nprimeira requisição.\u003c/p\u003e\n",
          "eventos": [
            {
              "n": 17,
              "de": "api",
              "para": "kcm",
              "msg": "O controller de EndpointSlice vê o Pod Ready",
              "estados": {
                "pod": "ativo"
              }
            },
            {
              "n": 18,
              "de": "kcm",
              "para": "api",
              "msg": "Ele grava o IP do Pod no EndpointSlice do Service pix-gateway",
              "estados": {
                "pod": "ativo"
              }
            },
            {
              "n": 19,
              "de": "api",
              "para": "proxy",
              "msg": "Cada kube-proxy recebe o endpoint novo e reprograma as regras do seu nó",
              "estados": {
                "pod": "ativo"
              }
            }
          ],
          "sequencia": {
            "id": "k8s-do-apply-ao-pod-ready-service",
            "tipo": "sequencia",
            "titulo": "O Pod entra no Service",
            "descricao": "Etapa \"O Pod entra no Service\" em sequência: 3 eventos entre 3 atores.",
            "participantes": [
              {
                "id": "api",
                "rotulo": "kube-apiserver"
              },
              {
                "id": "kcm",
                "rotulo": "kube-controller-manager"
              },
              {
                "id": "proxy",
                "rotulo": "kube-proxy"
              }
            ],
            "mensagens": [
              {
                "de": "api",
                "para": "kcm",
                "rotulo": "watch",
                "tipo": "async"
              },
              {
                "de": "kcm",
                "para": "api",
                "rotulo": "cria objetos",
                "tipo": "sync"
              },
              {
                "de": "api",
                "para": "proxy",
                "rotulo": "EndpointSlice",
                "tipo": "async"
              }
            ]
          },
          "omitidos": 7
        }
      ],
      "total": 19
    }
  }
