              "de": "as",
              "para": "client",
              "msg": "O fin-idp emite um access_token e um refresh_token novos e invalida o anterior",
              "anotacao": "rotação a cada uso"
            },
            {
              "n": 15,
              "de": "atacante",
              "para": "as",
              "msg": "Um atacante tenta usar o refresh_token antigo, copiado antes da rotação",
              "estados": {
