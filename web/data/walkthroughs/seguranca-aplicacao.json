      "paineis": [
        {
          "id": "tutorial",
          "linguagem": "bash",
          "titulo": "o tutorial deste marco",
          "linhas": [
            "# 1. gere code_verifier (43-128 chars, base64url) e o code_challenge (S256)",
            "CODE_VERIFIER=$(openssl rand -base64 96 | tr -d '=+/\\n' | cut -c1-64)",
            "CODE_CHALLENGE=$(echo -n \"$CODE_VERIFIER\" | openssl dgst -sha256 -binary | base64 | tr -d '=' | tr '/+' '_-')",
            "STATE=$(openssl rand -hex 16)",
            "NONCE=$(openssl rand -hex 16)",
            "",
            "# 2. monte a URL de autorização e abra no navegador (o login é interativo)",
            "echo \"http://localhost:9000/oauth2/authorize?response_type=code\u0026client_id=pix-gateway\u0026redirect_uri=http://localhost:8080/callback\u0026scope=openid%20payments:read\u0026state=${STATE}\u0026nonce=${NONCE}\u0026code_challenge=${CODE_CHALLENGE}\u0026code_challenge_method=S256\"",
            "",
            "# 3. depois do login, copie o \"code\" da query string do redirect e troque por token",
            "AUTH_CODE=\"\u003ccole o code aqui\u003e\"",
            "curl -s -X POST http://localhost:9000/oauth2/token \\",
            "  -u \"pix-gateway:$(cat client-secret.txt)\" \\",
            "  -d \"grant_type=authorization_code\" \\",
            "  -d \"code=${AUTH_CODE}\" \\",
            "  -d \"redirect_uri=http://localhost:8080/callback\" \\",
            "  -d \"code_verifier=${CODE_VERIFIER}\" | jq .",
            "",
            "# 4. inspecione o id_token (JWS: header.payload.signature) sem verificar assinatura,",
            "#    só para ler as claims; o nonce dele tem de ser o que você gerou no passo 1",
            "ID_TOKEN=\"\u003ccole o id_token da resposta acima\u003e\"",
            "echo \"$ID_TOKEN\" | cut -d. -f2 | tr '_-' '/+' | base64 -d 2\u003e/dev/null | jq .",
            "echo \"esperado: nonce=${NONCE}\""
          ]
        }
      ],
      "etapas": [
        {
          "id": "preparar",
          "titulo": "Os segredos desta requisição",
          "subtitulo": "Gerados antes de sair de casa",
          "camada": "fluxo",
          "html": "\u003cp\u003eAntes de qualquer redirect, o client gera três valores só desta requisição: o\n\u003ccode\u003ecode_verifier\u003c/code\u003e (e o seu hash, o \u003ccode\u003ecode_challenge\u003c/code\u003e), o \u003ccode\u003estate\u003c/code\u003e e o \u003ccode\u003enonce\u003c/code\u003e. O navegador vai\ncarregar o challenge, nunca o verifier. Com \u003cstrong\u003ePAR\u003c/strong\u003e, como no diagrama acima, estes\nparâmetros iriam por back-channel e o navegador levaria só uma referência opaca.\u003c/p\u003e\n",
          "eventos": [
            {
              "n": 1,
              "de": "client",
              "para": "titular",
              "msg": "O pix-gateway gera verifier, challenge, state e nonce e redireciona o navegador ao fin-idp",
              "painel": {
                "id": "tutorial",
                "de": 1,
                "ate": 5
              }
            },
            {
              "n": 2,
              "de": "titular",
              "para": "as",
              "msg": "O navegador leva ao /authorize o client_id, a redirect_uri, o escopo, o state, o nonce e o challenge",
              "anotacao": "o verifier nunca passa pelo navegador",
              "painel": {
                "id": "tutorial",
                "de": 8,
                "ate": 8
              }
            }
